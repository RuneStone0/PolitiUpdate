# X OAuth 1.0a credentials (Free tier — required for posting)
# Get these from https://developer.x.com/en/portal → your App → Keys and tokens
# Generate under "OAuth 1.0a" section. App must have Read and Write permissions.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# X OAuth 2.0 credentials (Basic tier+ — alternative to OAuth 1.0a)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://localhost:5000/callback
# X_REFRESH_TOKEN=

# X Premium mode: set to 1 to enable full-length posts (>280 chars)
# Requires an X Premium subscription on the posting account.
# X_PRO=1

# LLM summarization: condense posts exceeding POST_MAX_CHARS via DeepSeek.
# Recommended without X_PRO. Falls back to clean truncation if API fails.
# LLM_ENABLED=1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TIMEOUT=10

# Test mode: set to 1 to skip X posting (log only)
# (removed in this branch; use separate dev/prod environments instead)

# Health check HTTP server (0 = disabled, default: 8080)
# HEALTH_PORT=8080

# X stats → GitHub Gist (used by ./scripts/run-x-stats.sh and the x-stats service)
# Personal Access Token with the "gist" scope.
# GITHUB_GIST_TOKEN=
# Optional: explicit gist ID to update in place (otherwise found by description).
# X_STATS_GIST_ID=
# Optional: X account username to fetch stats for (default: PolitiUpdate).
# X_STATS_USERNAME=PolitiUpdate
# Optional: stats cache TTL in seconds (default: 7 days).
# X_STATS_CACHE_SECONDS=604800

# Optional overrides
# RSS_FEED_URL=https://via.ritzau.dk/rss/short-messages/latest
# POLL_INTERVAL_SECONDS=30
# DB_PATH=data/politiupdate.db
# POST_MAX_CHARS=280
# RATE_LIMIT_BACKOFF=900
# Failed posts older than this (since original publish) are given up on
# instead of retried. Retries run every ~40 min (see RETRY_EVERY_POLLS in
# src/bot/main.py), so 1h only gives a failed post ~1 retry attempt before
# a transient outage (e.g. an X API 503) causes it to be dropped as stale.
# MAX_ARTICLE_AGE_HOURS=4
# MAX_NEW_ITEMS_PER_POLL=5

# Content dedupe: the Ritzau feed re-publishes the same update under a new
# pressemeddelelse id (new guid, often a different district prefix, so the
# tweet text differs too), which the guid and exact-text checks miss. A scraped
# body at/above CONTENT_DEDUPE_THRESHOLD similarity to one posted under a
# *different* press release within CONTENT_DEDUPE_HOURS is skipped instead of
# posted twice. Keep the threshold near 1.0: the 0.95-0.97 band is
# re-published *corrections* (a missing person's name scrubbed after they are
# found) and 0.80-0.94 is genuine follow-up updates — both must still post.
# CONTENT_DEDUPE_ENABLED=1
# CONTENT_DEDUPE_HOURS=24
# CONTENT_DEDUPE_THRESHOLD=0.98

# Monthly feedback-request tweet (./docker-compose.yml's `feedback-post`
# service; runs once and exits, schedule it with host cron/Portainer, e.g.
# `0 17 * * 6 docker compose run --rm feedback-post`). Reuses the X OAuth
# 1.0a credentials above. Actually posts only on the first Saturday of the
# month, at/after FEEDBACK_HOUR_LOCAL in FEEDBACK_TIMEZONE — cron can't
# express that directly, so the app gates it internally (see src/feedback).
# FEEDBACK_STATE_PATH=data/feedback_state.json
# FEEDBACK_TIMEZONE=Europe/Copenhagen
# FEEDBACK_HOUR_LOCAL=18
# Optional: fixed year-month to post for (e.g. 2026-08), mainly for testing.
# Skips the first-Saturday/hour gate, like `python -m src.feedback --month`.
# FEEDBACK_MONTH_OVERRIDE=

# Notifications (used by the persistent `notify` service; see
# docker-compose.yml). Sends alerts to a Prowl webhook. `notify` self-
# schedules its own daily/weekly checks (see src/notify/loop.py) — no cron
# or GitHub Actions needed.
# Required. The URL itself is unauthenticated (anyone who knows it can POST
# messages to your phone) — keep it out of version control, set it only here
# or in your Portainer stack's env vars, never commit the real value.
# PROWL_WEBHOOK_URL=
# Bot health endpoint, reachable by service name on the compose network.
# BOT_HEALTH_URL=http://bot:8080/health
# Alert when this many posts are stuck in 'failed' status.
# NOTIFY_FAILED_POSTS_THRESHOLD=3
# Real-time error alerts from the bot's error logs (RSS fetch failures,
# permission/config problems, unexpected exceptions, etc). Ordinary X API
# posting hiccups (401/503 — see src/bot/poster.py) are intentionally logged
# at WARNING rather than ERROR, so they don't page here; they surface via
# the dropped-posts digest below instead once actually given up on. On by
# default; set to 0 to disable.
# NOTIFY_ON_ERROR=0
# NOTIFY_ERROR_MIN_INTERVAL=900
# How often (hours) to check for posts permanently given up on as stale
# (status="dropped_stale") and send one batched digest if there are any —
# the low-noise, delay-tolerant counterpart to the real-time alerts above.
# NOTIFY_DIGEST_INTERVAL_HOURS=4
# When the daily/weekly checks fire, in UTC. Weekday: Monday=0 .. Sunday=6.
# NOTIFY_DAILY_HOUR_UTC=9
# NOTIFY_WEEKLY_WEEKDAY=6
# NOTIFY_WEEKLY_HOUR_UTC=10
# NOTIFY_LOOP_CHECK_INTERVAL_SECONDS=300
# The weekly job also refreshes/publishes X stats (like x-stats does) using
# GITHUB_GIST_TOKEN above, and reports the follower delta since the last
# run — that state is stored locally, see NOTIFY_STATE_PATH.
# NOTIFY_STATE_PATH=data/notify_state.json

# Weekly region-filtered newsletter (src/newsletter) — sent as Brevo email
# campaigns. The send is gated: with none of these set the pipeline still
# builds region briefings under `python -m src.newsletter --dry-run`.
# Brevo API key (SECRET — never commit the real value; set it in the host env).
# BREVO_API_KEY=
# Authenticated sender — requires a verified sending domain.
# BREVO_SENDER_EMAIL=nyhedsbrev@mail.politiupdate.com
# BREVO_SENDER_NAME=PolitiUpdate
# Name of the Brevo contact attribute holding a subscriber's region.
# BREVO_REGION_ATTRIBUTE=REGION
# Brevo list ids per region (created 2026-09-10 via the API).
# BREVO_LIST_HOVEDSTADEN=3
# BREVO_LIST_SJAELLAND=4
# BREVO_LIST_JYLLAND=5
# BREVO_LIST_FYN=6
# BREVO_LIST_HELE_LANDET=7
# Optional: custom Brevo unsubscribe page id (24-char) attached to campaigns.
# Create it in Brevo → Settings → Campaigns → Unsubscribe pages.
# BREVO_UNSUB_PAGE_ID=
# Optional: force a specific ISO week (testing); state file prevents re-sends.
# NEWSLETTER_WEEK_OVERRIDE=
# NEWSLETTER_STATE_PATH=data/newsletter_state.json
